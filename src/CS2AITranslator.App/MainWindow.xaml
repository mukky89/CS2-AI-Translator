<Window x:Class="CS2AITranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 AI Translator" Height="620" Width="840" MinHeight="560" MinWidth="760"
        Background="#101318" Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="CS2 AI TRANSLATOR" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Local-first live comms translation · external to CS2 · no game injection" Opacity="0.65" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Audio source" Margin="0,0,0,6" />
                <ComboBox x:Name="CaptureModeBox" SelectedIndex="0" Padding="8">
                    <ComboBoxItem Content="CS2 only (recommended)" Tag="cs2" />
                    <ComboBoxItem Content="Windows output fallback" Tag="system" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0">
                <TextBlock Text="Whisper model" Margin="0,0,0,6" />
                <ComboBox x:Name="ModelTypeBox" SelectedIndex="1" Padding="8">
                    <ComboBoxItem Content="Tiny · fastest" Tag="Tiny" />
                    <ComboBoxItem Content="Base · recommended" Tag="Base" />
                    <ComboBoxItem Content="Small · higher accuracy" Tag="Small" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="Translate to" Margin="0,0,0,6" />
                <ComboBox x:Name="TargetLanguageBox" SelectedIndex="0" Padding="8">
                    <ComboBoxItem Content="Slovak" Tag="sk" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="Czech" Tag="cs" />
                    <ComboBoxItem Content="German" Tag="de" />
                    <ComboBoxItem Content="Polish" Tag="pl" />
                    <ComboBoxItem Content="Russian" Tag="ru" />
                    <ComboBoxItem Content="Ukrainian" Tag="uk" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#171C23" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Translation: " Opacity="0.55" />
                <TextBlock x:Name="ProviderText" Text="CS2 normalization only (set DEEPL_API_KEY for DeepL)" />
                <TextBlock Text="   ·   Model: " Opacity="0.55" />
                <TextBlock x:Name="ModelStatusText" Text="download on first start" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#171C23" CornerRadius="12" Padding="18">
            <StackPanel>
                <TextBlock Text="LIVE COMMS" FontSize="12" Opacity="0.55" />
                <TextBlock x:Name="StatusText" Text="Stopped" Margin="0,8,0,18" FontSize="14" />
                <TextBlock x:Name="OriginalText" Text="Incoming CS2 voice will appear here…" Opacity="0.55" FontSize="15" TextWrapping="Wrap" />
                <TextBlock x:Name="TranslatedText" Text="" Margin="0,12,0,0" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="LatencyText" Text="" Margin="0,16,0,0" HorizontalAlignment="Right" Opacity="0.5" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OverlayButton" Content="Show overlay" Padding="18,10" Margin="0,0,10,0" Click="OverlayButton_Click" />
            <Button x:Name="StartButton" Content="Start translator" Padding="22,10" Click="StartButton_Click" />
        </StackPanel>
    </Grid>
</Window>
