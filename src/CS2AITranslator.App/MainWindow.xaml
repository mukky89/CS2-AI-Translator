<Window x:Class="CS2AITranslator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 AI Translator" Height="520" Width="760" MinHeight="460" MinWidth="660"
        Background="#101318" Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="CS2 AI TRANSLATOR" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="External Windows voice translator — no game injection" Opacity="0.65" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Whisper model" Margin="0,0,0,6" />
                <TextBox x:Name="ModelPathBox" Text="models/ggml-base.bin" Padding="9" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Target language" Margin="0,0,0,6" />
                <ComboBox x:Name="TargetLanguageBox" SelectedIndex="0" Padding="8">
                    <ComboBoxItem Content="Slovak" Tag="sk" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="Czech" Tag="cs" />
                    <ComboBoxItem Content="German" Tag="de" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#171C23" CornerRadius="12" Padding="18">
            <StackPanel>
                <TextBlock Text="LIVE" FontSize="12" Opacity="0.55" />
                <TextBlock x:Name="StatusText" Text="Stopped" Margin="0,8,0,16" FontSize="14" />
                <TextBlock x:Name="OriginalText" Text="Incoming speech will appear here…" Opacity="0.55" FontSize="15" TextWrapping="Wrap" />
                <TextBlock x:Name="TranslatedText" Text="" Margin="0,12,0,0" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="LatencyText" Text="" Margin="0,12,0,0" HorizontalAlignment="Right" Opacity="0.5" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OverlayButton" Content="Show overlay" Padding="18,10" Margin="0,0,10,0" Click="OverlayButton_Click" />
            <Button x:Name="StartButton" Content="Start translator" Padding="22,10" Click="StartButton_Click" />
        </StackPanel>
    </Grid>
</Window>
