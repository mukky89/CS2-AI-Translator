<Window x:Class="CS2AITranslator.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="680" Height="190" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="#DD101318" CornerRadius="14" Padding="18" BorderBrush="#334FFFFFFF" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="CS2 AI TRANSLATOR" FontSize="11" Foreground="#99FFFFFF" />
            <TextBlock x:Name="OverlayOriginal" Text="Waiting for speech…" Margin="0,10,0,0" FontSize="14" Foreground="#AAFFFFFF" TextWrapping="Wrap" />
            <TextBlock x:Name="OverlayTranslation" Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
            <TextBlock x:Name="OverlayLatency" HorizontalAlignment="Right" Margin="0,8,0,0" FontSize="11" Foreground="#88FFFFFF" />
        </StackPanel>
    </Border>
</Window>
